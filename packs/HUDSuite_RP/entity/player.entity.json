    ],
    "pre_animation": [
     "variable.helmet_layer_visible = !query.has_head_gear;",
     "variable.leg_layer_visible = 1.0;",
     "variable.boot_layer_visible = 1.0;",
     "variable.chest_layer_visible = 1.0;",
     "variable.attack_body_rot_y = Math.sin(360*Math.sqrt(variable.attack_time)) * 5.0;",
     "variable.tcos0 = (math.cos(query.modified_distance_moved * 38.17) * query.modified_move_speed / variable.gliding_speed_value) * 57.3;",
     "variable.first_person_rotation_factor = math.sin((1 - variable.attack_time) * 180.0);",
     "variable.hand_bob = query.life_time < 0.01 ? 0.0 : variable.hand_bob + ((query.is_on_ground && query.is_alive ? math.clamp(math.sqrt(math.pow(query.position_delta(0), 2.0) + math.pow(query.position_delta(2), 2.0)), 0.0, 0.1) : 0.0) - variable.hand_bob) * 0.02;",
     "variable.map_angle = math.clamp(1 - variable.player_x_rotation / 45.1, 0.0, 1.0);",
     "variable.item_use_normalized = query.main_hand_item_use_duration / query.main_hand_item_max_duration;",
     "variable.riding_y_offset = query.is_riding_any_entity_of_type('minecraft:minecart', 'minecraft:boat', 'minecraft:chest_boat', 'minecraft:strider') ? -3.0 : 0.0;",
     "variable.hs_doll = variable.is_paperdoll && !query.is_in_ui;",
     "variable.hs_show = variable.hs_doll && query.is_pack_setting_enabled('hs:readout');",
     "variable.hs_sf = query.is_pack_setting_enabled('hs:show_fps');",
     "variable.hs_sc = query.is_pack_setting_enabled('hs:show_cps');",
     "variable.hs_size = query.get_pack_setting('hs:size');",
     "variable.hs_size = variable.hs_size > 0 ? variable.hs_size / 100.0 : 1.0;",
     "variable.hs_xi = math.clamp(math.round((query.get_pack_setting('hs:move_x') - (-60)) / 10), 0, 12);",
     "variable.hs_y = query.get_pack_setting('hs:move_y');",
     "variable.hs_dt = math.clamp(query.delta_time, 0.001, 1.0);",
     "variable.hs_fps_s = variable.hs_fps_s + (1.0 / variable.hs_dt - variable.hs_fps_s) * math.min(variable.hs_dt * 4.0, 1.0);",
     "variable.hs_upd = (query.life_time - variable.hs_fps_t) >= 0.25 || query.life_time < variable.hs_fps_t;",
     "variable.hs_fps = variable.hs_upd ? math.clamp(math.round(variable.hs_fps_s), 0, 999) : variable.hs_fps;",
     "variable.hs_fps_t = variable.hs_upd ? query.life_time : variable.hs_fps_t;",
     "variable.hs_click = variable.attack_time > 0 && (variable.hs_prev_at <= 0 || variable.attack_time < variable.hs_prev_at);",
     "variable.hs_prev_at = variable.attack_time;",
     "variable.hs_c19 = variable.hs_click ? variable.hs_c18 : variable.hs_c19;",
     "variable.hs_c18 = variable.hs_click ? variable.hs_c17 : variable.hs_c18;",
     "variable.hs_c17 = variable.hs_click ? variable.hs_c16 : variable.hs_c17;",
     "variable.hs_c16 = variable.hs_click ? variable.hs_c15 : variable.hs_c16;",
     "variable.hs_c15 = variable.hs_click ? variable.hs_c14 : variable.hs_c15;",
     "variable.hs_c14 = variable.hs_click ? variable.hs_c13 : variable.hs_c14;",
     "variable.hs_c13 = variable.hs_click ? variable.hs_c12 : variable.hs_c13;",
     "variable.hs_c12 = variable.hs_click ? variable.hs_c11 : variable.hs_c12;",
     "variable.hs_c11 = variable.hs_click ? variable.hs_c10 : variable.hs_c11;",
     "variable.hs_c10 = variable.hs_click ? variable.hs_c9 : variable.hs_c10;",
     "variable.hs_c9 = variable.hs_click ? variable.hs_c8 : variable.hs_c9;",
     "variable.hs_c8 = variable.hs_click ? variable.hs_c7 : variable.hs_c8;",
     "variable.hs_c7 = variable.hs_click ? variable.hs_c6 : variable.hs_c7;",
     "variable.hs_c6 = variable.hs_click ? variable.hs_c5 : variable.hs_c6;",
     "variable.hs_c5 = variable.hs_click ? variable.hs_c4 : variable.hs_c5;",
     "variable.hs_c4 = variable.hs_click ? variable.hs_c3 : variable.hs_c4;",
     "variable.hs_c3 = variable.hs_click ? variable.hs_c2 : variable.hs_c3;",
     "variable.hs_c2 = variable.hs_click ? variable.hs_c1 : variable.hs_c2;",
     "variable.hs_c1 = variable.hs_click ? variable.hs_c0 : variable.hs_c1;",
     "variable.hs_c0 = variable.hs_click ? query.life_time : variable.hs_c0;",
     "variable.hs_cps = (query.life_time - variable.hs_c0 < 1.0) + (query.life_time - variable.hs_c1 < 1.0) + (query.life_time - variable.hs_c2 < 1.0) + (query.life_time - variable.hs_c3 < 1.0) + (query.life_time - variable.hs_c4 < 1.0) + (query.life_time - variable.hs_c5 < 1.0) + (query.life_time - variable.hs_c6 < 1.0) + (query.life_time - variable.hs_c7 < 1.0) + (query.life_time - variable.hs_c8 < 1.0) + (query.life_time - variable.hs_c9 < 1.0) + (query.life_time - variable.hs_c10 < 1.0) + (query.life_time - variable.hs_c11 < 1.0) + (query.life_time - variable.hs_c12 < 1.0) + (query.life_time - variable.hs_c13 < 1.0) + (query.life_time - variable.hs_c14 < 1.0) + (query.life_time - variable.hs_c15 < 1.0) + (query.life_time - variable.hs_c16 < 1.0) + (query.life_time - variable.hs_c17 < 1.0) + (query.life_time - variable.hs_c18 < 1.0) + (query.life_time - variable.hs_c19 < 1.0);"
    ],
